# Copy to .env and replace every value. Never commit .env.
POSTGRES_PASSWORD=change-me-long-random
S3_ACCESS_KEY=hebra
S3_SECRET_KEY=change-me-long-random
# `docker run --rm hebra-server:dev keygen` (or `hebra-server keygen`); to
# rotate, put the new key first and keep the old ones after it, comma separated.
HEBRA_ENCRYPTION_KEYS=
# Signs mandates and the transparency log: `hebra-server keygen mandate`.
# Keep it secret and stable; changing it signs everyone out.
HEBRA_MANDATE_KEY=
# Where people reach this Hebra (used in sign-in and invitation links).
HEBRA_PUBLIC_URL=https://localhost
# `invite` (an administrator sends links) or `open` (anyone with GitHub).
HEBRA_SIGNUP=invite
# Optional: sign in with GitHub (an OAuth app whose callback is
# <HEBRA_PUBLIC_URL>/auth/github/callback).
HEBRA_GITHUB_CLIENT_ID=
HEBRA_GITHUB_CLIENT_SECRET=
