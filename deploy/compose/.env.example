# Copy to .env and replace every value. Never commit .env.
POSTGRES_PASSWORD=change-me-long-random
S3_ACCESS_KEY=hebra
S3_SECRET_KEY=change-me-long-random
# `docker run --rm hebra-server:dev keygen` (or `hebra-server keygen`); to
# rotate, put the new key first and keep the old ones after it, comma separated.
HEBRA_ENCRYPTION_KEYS=
